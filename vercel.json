{
  "version": 2,
  "buildCommand": "cd backend && npm install && cd ../frontend && npm install && cd ../backend && npx prisma generate && cd ../frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'Dependencies installed in buildCommand'",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs18.x",
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
